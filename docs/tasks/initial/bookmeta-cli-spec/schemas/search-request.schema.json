{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bookmeta/search-request.schema.json",
  "title": "bookmeta SearchRequest",
  "type": "object",
  "properties": {
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "narrator": {
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "type": [
        "string",
        "null"
      ]
    },
    "isbn": {
      "type": [
        "string",
        "null"
      ]
    },
    "asin": {
      "type": [
        "string",
        "null"
      ]
    },
    "sku": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "duration_tolerance_seconds": {
      "type": "integer",
      "minimum": 1,
      "default": 90
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9
    },
    "limit_per_provider": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "exact": {
      "type": "boolean",
      "default": false
    },
    "include_shop_links": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
