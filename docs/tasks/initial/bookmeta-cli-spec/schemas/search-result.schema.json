{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bookmeta/search-result.schema.json",
  "title": "bookmeta SearchResult",
  "type": "object",
  "required": [
    "provider",
    "provider_type",
    "title",
    "authors",
    "narrators",
    "series",
    "identifiers",
    "score",
    "warnings"
  ],
  "properties": {
    "provider": {
      "type": "string"
    },
    "provider_type": {
      "type": "string"
    },
    "provider_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lookup_strategy": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narrators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "url": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sequence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "identifiers": {
      "type": "object",
      "required": [
        "asin",
        "isbn10",
        "isbn13",
        "other"
      ],
      "properties": {
        "asin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isbn10": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isbn13": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "other": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_year": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "rating": {
      "type": [
        "number",
        "null"
      ]
    },
    "format": {
      "type": [
        "string",
        "null"
      ]
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_available": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_buyable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_listenable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_virtual_voice": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "abridged": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "short_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "liner_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "shop_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "url"],
        "properties": {
          "provider": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string", "null"] },
          "ean": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
          "abridged": { "type": ["boolean", "null"] },
          "shop_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["provider", "url"],
              "properties": {
                "provider": { "type": "string" },
                "url": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "id": { "type": ["string", "null"] },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "enum": [
        "exact",
        "high",
        "medium",
        "low",
        null
      ]
    },
    "identifier_match_kind": {
      "enum": [
        "sku_exact",
        "sku_group",
        "asin_exact",
        "isbn_exact"
      ]
    },
    "match_assessment": {
      "enum": [
        "identifier_match",
        "corroborated_identifier_match",
        "conflicting_identifier_match"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "requested", "candidate", "reason"],
        "properties": {
          "field": { "type": "string" },
          "requested": { "type": "string" },
          "candidate": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "work_cluster_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "edition_cluster_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw": {}
  },
  "additionalProperties": false
}
